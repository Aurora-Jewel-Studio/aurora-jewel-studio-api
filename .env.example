# Copy to .env for local development. Never commit real values.

# PostgreSQL
POSTGRES_URL="postgresql://<user>:<password>@<host>:5432/<database>?sslmode=verify-full"

# Admin authentication
ADMIN_JWT_SECRET="<generate-at-least-32-random-characters>"
ADMIN_EMAIL="<admin-email>"
ADMIN_PASSWORD="<strong-admin-password>"

# Browser origins and payment redirects
ALLOWED_ORIGINS="https://aurorajewelstudio.com,https://www.aurorajewelstudio.com"
FRONTEND_URL="https://aurorajewelstudio.com"

# SMTP enquiry notification
SMTP_HOST="<smtp-host>"
SMTP_PORT="465"
SMTP_USER="<smtp-username>"
SMTP_PASS="<smtp-password>"
ENQUIRY_NOTIFICATION_EMAIL="<notification-recipient>"

# Stripe
STRIPE_SECRET_KEY="<stripe-secret-key>"
STRIPE_WEBHOOK_SECRET="<stripe-webhook-secret>"

# PayPal
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID="<paypal-client-id>"
PAYPAL_CLIENT_SECRET="<paypal-client-secret>"

# Khalti
KHALTI_SECRET_KEY="<khalti-secret-key>"

# eSewa ePay v2
ESEWA_ENV="sandbox"
ESEWA_MERCHANT_CODE="<esewa-merchant-code>"
ESEWA_SECRET_KEY="<esewa-secret-key>"
